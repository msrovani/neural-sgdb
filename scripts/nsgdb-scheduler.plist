<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.neural-sgdb.scheduler</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/nsgdb-scheduler</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>NEURAL_SGDB_DB</key><string>/usr/local/var/nsgdb/memory.db</string></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/nsgdb-scheduler.log</string>
  <key>StandardErrorPath</key><string>/tmp/nsgdb-scheduler.log</string>
</dict>
</plist>
