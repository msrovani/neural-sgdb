{
  "mcpServers": {
    "neural-sgdb": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}${/}scripts${/}mcp-server.ps1"
      ],
      "env": {
        "NEURAL_SGDB_EMBEDDER": "demo",
        "NEURAL_SGDB_DEFAULT_SCOPE": "project/neural-sgdb"
      }
    }
  }
}
